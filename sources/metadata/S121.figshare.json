{"files": [{"id": 59832669, "name": "au5c01294_si_001.pdf", "size": 1270025, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/59832669", "supplied_md5": "db254eb0fedda0d4a1cd9bee7d025f30", "computed_md5": "db254eb0fedda0d4a1cd9bee7d025f30", "mimetype": "application/pdf"}], "folder_structure": {}, "authors": [{"id": 4512649, "full_name": "UnJin Ryu", "first_name": "UnJin", "last_name": "Ryu", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 13563517, "full_name": "Youn Ji Min", "first_name": "Youn Ji", "last_name": "Min", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 849310, "full_name": "Wenyang Zhao", "first_name": "Wenyang", "last_name": "Zhao", "is_active": false, "url_name": "Wenyang_Zhao", "orcid_id": ""}, {"id": 9982197, "full_name": "Yunseok Lee", "first_name": "Yunseok", "last_name": "Lee", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 1274034, "full_name": "Matthew J. Realff", "first_name": "Matthew J.", "last_name": "Realff", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 543968, "full_name": "Christopher W. Jones", "first_name": "Christopher W.", "last_name": "Jones", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://acs.figshare.com/articles/journal_contribution/Climatic_Conditions_and_Amine_Loading_Impact_the_Performance_of_Laminate-Supported_Poly_ethylenimine_Direct_Air_Capture_Sorbents/30708201", "download_disabled": false, "description": "Direct air capture (DAC) of CO<sub>2</sub> is a critical\ntechnology\nto combat climate change, offering a scalable approach to mitigate\natmospheric CO<sub>2</sub> accumulation. Despite advancements in adsorbent\nmaterials, the performance of DAC systems remains highly sensitive\nto environmental conditions, such as temperature and humidity. Poly(ethylenimine)\n(PEI)-functionalized silica has emerged as a promising sorbent due\nto its high CO<sub>2</sub> capacity and tunable properties. However,\noptimizing its performance across diverse climatic conditions requires\na deeper understanding of how the PEI loading impacts the adsorption\ncapacity and kinetics under varying temperatures and humidities. This\nstudy reports the CO<sub>2</sub> and H<sub>2</sub>O adsorption kinetics\nand capacities, desorption behavior, and speciation of adsorbed CO<sub>2</sub> using silica/PEI adsorbents supported within expanded poly(tetrafluoroethylene)\n(ePTFE) sheets across a wide range of temperatures and humidities,\nrepresenting the diversity of climates found across the United States.\nWith the obtained data, guidelines for selecting and optimizing PEI-loaded\nsilica-based sorbents for DAC applications are developed. These findings\nprovide a framework for tailoring sorbents to specific climatic scenarios,\nensuring a reliable and efficient DAC performance.", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 1270025, "created_date": "2025-11-25T13:12:30Z", "modified_date": "2025-11-25T13:18:04Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 10, "name": "CC BY-NC 4.0", "url": "https://creativecommons.org/licenses/by-nc/4.0/"}, "tags": ["promising sorbent due", "combat climate change", "amine loading impact", "specific climatic scenarios", "pei loading impacts", "climates found across", "mitigate atmospheric co", "2 </ sub", "efficient dac performance", "sheets across", "climatic conditions", "wide range", "using silica", "united states", "tunable properties", "tailoring sorbents", "study reports", "scalable approach", "optimizing pei", "obtained data", "loaded silica", "high co", "findings provide", "environmental conditions", "despite advancements", "desorption behavior", "deeper understanding", "dac applications", "critical technology", "based sorbents", "adsorbent materials", "adsorbed co"], "keywords": ["promising sorbent due"
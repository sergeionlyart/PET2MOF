*.env
!.env.example
!**/.env.example
secrets/
.secrets/
private/
.local/
.agent_sessions/
**/credentials*.json
**/auth.json
**/service_account*.json
**/application_default_credentials.json
*.pem
*.key
*.p12
*.pfx

# --- Python / tooling ---
.venv/
.uv-cache/
.venv-*/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/
tmp/

# --- Local, non-redistributable inputs (see sources/LICENSES.md) ---
data/raw/pdf/
data/raw/html/
data/raw/figures_full/

# --- OS ---
.DS_Store

# Full ISODB catalogs: re-fetchable via API, SHA-256 kept in data/raw/nist_isodb/manifest.csv
data/raw/nist_isodb/catalogs/
.uv-cache/

# NIST web pages (contain a third-party public map token; not needed for reproduction). URL + SHA-256 in manifest.csv
data/raw/nist_isodb/docs/*.html

# Large regenerable outputs (hashes kept in-repo)
*.npz

# Post-tag inputs/outputs stay local while HEAD remains exactly prereg-v1.
# Already tracked historical runs remain tracked. Hashes belong to passports.
/holdout/v1/
/reports/ensemble/
/reports/validation/
/runs/*/

# TASK-003 raw downloads (rights per source; not redistributed)
data/raw/task003/

# T044 review caches (local sources and renders; not redistributed)
reviews/T044_checks/source_downloads/
reviews/T044_checks/rendered/
reviews/T044_checks/lo_profile/
reviews/T044_checks/uv-cache/
reviews/T044_checks/pytest_tmp/
